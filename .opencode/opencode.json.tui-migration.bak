        }
      }
    }
  },

  "mcp": {
    "httpx": {
      "type": "remote",
      "url": "https://httpx-mcp.danielmiessler.workers.dev",
      "headers": {
        "x-api-key": "{env:HTTPX_API_KEY}"
      },
      "enabled": false
    },
    "brightdata": {
      "type": "local",
      "command": ["bunx", "@brightdata/mcp"],
      "environment": {
        "API_TOKEN": "{env:BRIGHTDATA_API_KEY}"
      },
      "enabled": true
    },
    "Ref": {
      "type": "local",
      "command": ["bunx", "@refdotai/mcp"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest", "--extension"],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      },
      "enabled": true
    },
    "n8n": {
      "type": "local",
      "command": ["bunx", "n8n-mcp"],
      "environment": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "",
        "N8N_API_URL": "{env:N8N_API_URL}",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      },
      "enabled": true
    },
    "supabase": {
      "type": "local",
      "command": ["bunx", "-y", "@aliyun-rds/supabase-mcp-server"],
      "environment": {
        "SUPABASE_URL": "{env:SUPABASE_URL}",
        "SUPABASE_ANON_KEY": "{env:SUPABASE_ANON_KEY}",
        "SUPABASE_SERVICE_ROLE_KEY": "{env:SUPABASE_SERVICE_ROLE_KEY}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "apify": {
      "type": "local",
      "command": ["bunx", "@apify/actors-mcp-server"],
      "environment": {
        "APIFY_TOKEN": "{env:APIFY_TOKEN}"
      },
      "enabled": true
    }
  }
}