{
  "$schema": "https://opencode.ai/config.json",
  "theme": "dark",
  "model": "z.ai/glm-5",
  "default_agent": "Algorithm",
  "snapshot": true,
  "username": "Kheeran",

  "plugin": ["opencode-scheduler"],

  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "/home/prowler/.opencode/*": "allow",
      "/home/prowler/working_dir/*": "allow",
      "/home/prowler/kheer/Dropbox/PKM/*": "allow",
      "/*": "allow",
      "/mnt/c/Users/kheer/Dropbox/PKM/*": "allow",
      "/": "ask"
		},
    "write": {
      "*": "allow",
      "/home/prowler/.opencode/*": "allow",
      "/home/prowler/working_dir/*": "allow",
      "/home/prowler/kheer/Dropbox/PKM/*": "allow",
      "/mnt/c/Users/kheer/Dropbox/PKM/*": "allow",
      "/": "ask"
		},
    "edit": {
      "*": "allow",
      "/home/prowler/.opencode/*": "allow",
      "/home/prowler/working_dir/*": "allow",
      "/home/prowler/kheer/Dropbox/PKM/*": "allow",
      "/mnt/c/Users/kheer/Dropbox/PKM/*": "allow",
      "/": "ask"
		},
    "bash": {
      "*": "ask",
      "bun *": "allow",
      "ls *": "allow",
      "git *": "allow",
      "mkdir *": "allow",
      "tree *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "jq *": "allow",
      "wc *": "allow",
      "scp *": "allow",
      "ssh *": "allow",
      "sort *": "allow",
      "sleep *": "allow",
      "file *": "allow",
      "html2text *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "which *": "allow",
      "type *": "allow",
      "date *": "allow",
      "whoami *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "id *": "allow",
      "node *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "tar *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "xargs *": "allow"
		},
	"grep": "allow",
	"glob": "allow",
	"task": "allow",
	"list": "allow",
	"skill": "allow",
	"patch": "allow",
	"question": "allow",
	"todoread": "allow",
	"todowrite": "allow",
	"webfetch *": "allow",
	"websearch *": "allow",
	"codesearch": "allow",
	"external_directory": {
		"*": "allow",
		"/etc/": "ask",
		"/bin/": "ask",
		"/sbin/": "ask",
		"/root/": "ask",
		"/usr/bin/": "ask",
		"/boot/": "ask",
		"/dev/": "ask",
		"/": "ask",
    "/home/prowler/.opencode/*": "allow",
    "/home/prowler/working_dir/*": "allow",
    "/home/prowler/kheer/Dropbox/PKM/*": "allow",
    "/mnt/c/Users/kheer/Dropbox/PKM/*": "allow"
		},
	"lsp": "allow"
  },

  "agent": {
    "Algorithm": {
      "model": "anthropic/claude-opus-4-6"
    },
    "Architect": {
      "model": "anthropic/claude-sonnet-4-5",
      "model_tiers": {
        "quick": {
          "model": "anthropic/claude-haiku-4-5"
        },
        "standard": {
          "model": "anthropic/claude-sonnet-4-5"
        },
        "advanced": {
          "model": "anthropic/claude-opus-4-6"
        }
      }
    },
    "Engineer": {
